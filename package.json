{
  "name": "tailwind-nextjs-starter-blog",
  "version": "1.5.6",
  "private": true,
  "scripts": {
    "start": "cross-env SOCKET=true node ./scripts/next-remote-watch.js ./data",
    "dev": "next dev",
    "build": "next build && node ./scripts/generate-sitemap.mjs",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "lint": "eslint --fix pages components lib layouts scripts",
    "compose": "node ./scripts/compose.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@mailchimp/mailchimp_marketing": "^3.0.80",
    "@next/bundle-analyzer": "16.4.6",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "esbuild": "^0.28.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "image-size": "^2.2.0",
    "js-yaml": "^4.1.0",
    "katex": "^0.19.1",
    "mdast-util-to-string": "^4.0.0",
    "mdx-bundler": "^10.1.1",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.34",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.3.2",
    "rehype-katex": "^7.0.1",
    "rehype-preset-minify": "^7.0.1",
    "rehype-prism-plus": "^2.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@svgr/webpack": "^8.1.0",
    "chalk": "^4.1.2",
    "chokidar": "^3.6.0",
    "commander": "^6.2.1",
    "cross-env": "^10.1.0",
    "dedent": "^1.7.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.9",
    "eslint-plugin-prettier": "^5.5.7",
    "express": "^4.21.2",
    "globals": "^17.14.0",
    "globby": "^16.2.4",
    "husky": "^9.1.7",
    "inquirer": "^14.3.1",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  }
}
